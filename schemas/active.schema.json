{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://waymark.local/schemas/active.schema.json",
  "title": "Waymark active pointer",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["waymark", "status", "updatedAt"],
      "properties": {
        "waymark": { "const": 1 },
        "status": { "const": "NONE" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["waymark", "status", "trajectoryId", "journal", "updatedAt"],
      "properties": {
        "waymark": { "const": 1 },
        "status": { "enum": ["STAGED", "STALE"] },
        "trajectoryId": { "type": "string", "pattern": "^[a-z0-9-]{8,80}$" },
        "journal": { "type": "string", "pattern": "^trajectories/[a-z0-9-]{8,80}\\.ndjson$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
