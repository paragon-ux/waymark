{
  "name": "waymark",
  "version": "1.6.0",
  "private": true,
  "description": "A lightweight active investigation ledger and WebAssembly discovery MCP server for AI coding agent continuity.",
  "type": "module",
  "main": "./dist/src/mcp/index.js",
  "bin": {
    "waymark": "./dist/src/mcp/waymarkIndex.js",
    "waymark-server": "./dist/src/mcp/waymarkIndex.js",
    "capn-mcp": "./dist/src/mcp/capnIndex.js",
    "waymark-capn": "./dist/src/mcp/capnIndex.js",
    "waymark-unified": "./dist/src/mcp/index.js",
    "waymark-operator": "./dist/src/cli.js",
    "waymark-hook": "./scripts/hooks/waymark-compact-hook.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "schema-check": "node scripts/schema-check.mjs",
    "public-check": "node scripts/public-check.mjs",
    "mermaid-check": "node scripts/verify-mermaid.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "verify": "npm run build && node --test \"dist/test/**/*.test.js\" && npm run schema-check && npm run public-check && npm run mermaid-check"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.0"
  }
}
