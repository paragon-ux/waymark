{
  "name": "waymark",
  "version": "0.1.0",
  "private": true,
  "description": "A dependency-free active investigation ledger for Codex compaction continuity.",
  "type": "module",
  "main": "./dist/src/mcp/index.js",
  "bin": {
    "waymark": "./dist/src/mcp/index.js",
    "waymark-server": "./dist/src/mcp/index.js",
    "waymark-operator": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "schema-check": "node scripts/schema-check.mjs",
    "public-check": "node scripts/public-check.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "verify": "npm run build && node --test \"dist/test/**/*.test.js\" && npm run schema-check && npm run public-check"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3"
  }
}
